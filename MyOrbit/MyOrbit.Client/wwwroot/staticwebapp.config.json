{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/login-github",
      "rewrite": "/.auth/login/github"
    },
    {
      "route": "/login-microsoft",
      "rewrite": "/.auth/login/aad"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,gif,svg}",
      "/css/*",
      "/*.ico",
      "/manifest.json"
    ]
  },
  "responseOverrides": {
    "401": {
      "redirect": "/login-github",
      "statusCode": 302
    }
  }
}